{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":approveMajorUpdates",
    "helpers:pinGitHubActionDigests"
  ],
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "description": "Require human approval before merging dependency updates",
      "matchPackageNames": ["*"],
      "automerge": false
    }
  ]
}
